---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import PricingCard from "@components/pricing.astro";

const pricing = [
  {
    name: "Teebloc",
    price: "$8.50/month",
    popular: true,
    features: [
      "Try up to 3 worksheets for free before subscribing",
      "Create unlimited worksheets after subscribing",
      "Access our latest database of past year paper questions",
      "Mix and match questions by subject, topic, level, paper type, assessment type, and school",
      "Access future features such as automatic composition marking and SG exam syllabus chatbots",
      "Receive live support from our team in the Telegram group",
    ],
    button: {
      text: "Try up to 3 free worksheets",
      link: "https://accounts.teebloc.com/sign-up?redirect_url=https://app.teebloc.com/",
    },
  },
];
---

<Layout title="Pricing">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Pricing</Fragment>
      <Fragment slot="desc">
        Start with up to 3 free worksheets. Subscribe when you need unlimited worksheet creation.
      </Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-xl mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
