---
import Link from "@components/ui/link.astro";
---

<section class="mt-10 md:mt-12">
  <div class="w-full md:w-3/4 mx-auto text-center">
    <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mb-4">
      Get ahead of the bell curve
    </h2>
    <p class="text-lg text-slate-600">
      Stop wasting time on unfocused practice. Maximise your learning by drilling your weakest topics.
    </p>

    <div class="mt-8 flex justify-center">
      <Link
        href="https://accounts.teebloc.com/sign-up?redirect_url=https://app.teebloc.com/"
        target="_blank"
        class="inline-flex gap-1 items-center justify-center"
        rel="noopener">
        Try up to 3 free worksheets
      </Link>
    </div>
  </div>
</section>
